<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#FFF8E7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sonidos de aves - Ramirez Zamorano Joan Enrique"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="25dp"/>

    <ImageButton
        android:id="@+id/btnAveAzul"
        android:layout_width="180dp"
        android:layout_height="130dp"
        android:src="@drawable/pajaro1"
        android:scaleType="fitCenter"
        android:background="#FFFFFF"
        android:contentDescription="Sonido de ave azul"
        android:padding="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AVE AZUL"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="15dp"/>

    <ImageButton
        android:id="@+id/btnTucan"
        android:layout_width="180dp"
        android:layout_height="130dp"
        android:src="@drawable/pajaro2"
        android:scaleType="fitCenter"
        android:background="#FFFFFF"
        android:contentDescription="Sonido de tucán"
        android:padding="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUCÁN"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="15dp"/>

    <ImageButton
        android:id="@+id/btnPaloma"
        android:layout_width="180dp"
        android:layout_height="130dp"
        android:src="@drawable/pajaro3"
        android:scaleType="fitCenter"
        android:background="#FFFFFF"
        android:contentDescription="Sonido de paloma"
        android:padding="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PALOMA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"/>

</LinearLayout>